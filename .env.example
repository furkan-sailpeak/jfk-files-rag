# Copy to .env and fill in. Read by the backend (rag/app/config.py) and by
# docker-compose.yml (the VITE_* values are frontend build args).

# --- Required -----------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/postgres
GROQ_API_KEY=

# --- Frontend build (public values, inlined into the JS bundle) ----------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Optional -----------------------------------------------------------------
# Sign-in / quota gate (off by default; see admin/todo.md)
SUPABASE_URL=
GATE_ENABLED=0
# Lock CORS to these origins in production (comma-separated); unset = open (dev)
ALLOWED_ORIGINS=
# Model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# JUDGE_MODEL=openai/gpt-oss-20b
# Only if switching back to the OpenAI embedding column
# EMBED_PROVIDER=openai
# OPENAI_API_KEY=
